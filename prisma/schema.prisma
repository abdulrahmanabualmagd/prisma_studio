  id                              Int                              @id @default(autoincrement())
  company_id                      Int?
  department_id                   Int?
  group_id                        Int?
  user_id                         Int?
  organization_id                 Int?
  snapshot                        Json?
  age_operators                   age_operators?
  agenda_slots                    agenda_slots?
  agenda_time_ranges              agenda_time_ranges?
  agenda_working_days             agenda_working_days?
  agendas                         agendas?
  aggregate_results               aggregate_results?
  antibiotic_families             antibiotic_families?
  antibiotic_family_groups        antibiotic_family_groups?
  antibiotic_trade_names          antibiotic_trade_names?
  antibiotics                     antibiotics?
  attachments                     attachments?
  companies                       companies?                       @relation(fields: [company_id], references: [id])
  departments                     departments?                     @relation(fields: [department_id], references: [id])
  groups                          groups?                          @relation(fields: [group_id], references: [id])
  organizations                   organizations?                   @relation(fields: [organization_id], references: [id], onDelete: NoAction)
  users                           users?                           @relation(fields: [user_id], references: [id])
  beneficiaries_pricelists        beneficiaries_pricelists?
  beneficiary_types               beneficiary_types?
  bill_items                      bill_items?
  bills                           bills?
  categories                      categories?
  category_groups                 category_groups?
  code_segments                   code_segments?
  code_templates                  code_templates?
  comment_entries                 comment_entries?
  comments                        comments?
  conditions_beneficiaries        conditions_beneficiaries?
  contract_conditions             contract_conditions?
  contractor_batches              contractor_batches?
  contractor_categories           contractor_categories?
  contractor_contact_titles       contractor_contact_titles?
  contractor_contacts             contractor_contacts?
  contractor_sales_logs           contractor_sales_logs?
  contractors                     contractors?
  contracts                       contracts?
  control_sample_specs            control_sample_specs?
  control_samples                 control_samples?
  currencies                      currencies?
  currency_transactions           currency_transactions?
  discounts                       discounts?
  formula_variables               formula_variables?
  formulas                        formulas?
  instruments                     instruments?
  invoice_adjustments             invoice_adjustments?
  invoice_items                   invoice_items?
  invoice_payment_methods         invoice_payment_methods?
  invoice_payments                invoice_payments?
  invoice_transactions            invoice_transactions?
  invoices                        invoices?
  manufacturers                   manufacturers?
  measurement_result_logs         measurement_result_logs?
  measurement_results             measurement_results?
  organisms                       organisms?
  patient_cases                   patient_cases?
  patient_classifications         patient_classifications?
  patient_extra_field_definitions patient_extra_field_definitions?
  patient_extra_field_options     patient_extra_field_options?
  patient_extra_field_values      patient_extra_field_values?
  patient_visits                  patient_visits?
  patients                        patients?
  price_logs                      price_logs?
  pricelist_items                 pricelist_items?
  pricelists                      pricelists?
  procedure_result_select_options procedure_result_select_options?
  procedure_results               procedure_results?
  procedure_samples               procedure_samples?
  procedures                      procedures?
  reference_ranges                reference_ranges?
  request_procedures              request_procedures?
  request_samples                 request_samples?
  request_services                request_services?
  requests                        requests?
  sample_types                    sample_types?
  samples                         samples?
  sensitivity_test_antibiotics    sensitivity_test_antibiotics?
  sensitivity_test_families       sensitivity_test_families?
  sensitivity_test_groups         sensitivity_test_groups?
  sensitivity_test_organisms      sensitivity_test_organisms?
  sequence_counters               sequence_counters?
  services                        services?
  standard_methods                standard_methods?
  status_states                   status_states?
  status_transitions              status_transitions?
  status_triggers                 status_triggers?
  statuses                        statuses?
  taxes                           taxes?
  test_profiles                   test_profiles?
  tests                           tests?
  unit_types                      unit_types?
  units                           units?
  workflows                       workflows?
}

model beneficiaries_pricelists {
  id                                               Int                       @id @default(autoincrement())
  deduction_type                                   String?                   @db.VarChar(255)
  copay_type                                       String?                   @db.VarChar(255)
  deduction_value                                  Decimal?                  @db.Decimal(10, 2)
  copay_value                                      Decimal?                  @db.Decimal(10, 2)
  is_fixed                                         Boolean?                  @default(false)
  condition_beneficiary_id                         Int?
  pricelist_id                                     Int?
  base_scope_id                                    Int?                      @unique
  created_at                                       DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime                  @db.Timestamptz(6)
  creator_id                                       Int?
  updater_id                                       Int?
  base_scopes                                      base_scopes?              @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  conditions_beneficiaries                         conditions_beneficiaries? @relation(fields: [condition_beneficiary_id], references: [id], onDelete: Cascade)
  users_beneficiaries_pricelists_creator_idTousers users?                    @relation("beneficiaries_pricelists_creator_idTousers", fields: [creator_id], references: [id])
  pricelists                                       pricelists?               @relation(fields: [pricelist_id], references: [id])
  users_beneficiaries_pricelists_updater_idTousers users?                    @relation("beneficiaries_pricelists_updater_idTousers", fields: [updater_id], references: [id])
  pricelist_items                                  pricelist_items[]         @relation("ContractConditionBeneficiaryPricelistToPricelistItem")
}

model beneficiary_types {
  id                                        Int                        @id @default(autoincrement())
  code                                      String?                    @db.VarChar(255)
  name_en                                   String?                    @db.VarChar(255)
  name_ar                                   String?                    @db.VarChar(255)
  description                               String?
  active                                    Boolean?
  base_scope_id                             Int?                       @unique
  created_at                                DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime                   @db.Timestamptz(6)
  creator_id                                Int?
  updater_id                                Int?
  contract_condition_id                     Int?
  base_scopes                               base_scopes?               @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  contract_conditions                       contract_conditions?       @relation(fields: [contract_condition_id], references: [id])
  users_beneficiary_types_creator_idTousers users?                     @relation("beneficiary_types_creator_idTousers", fields: [creator_id], references: [id])
  users_beneficiary_types_updater_idTousers users?                     @relation("beneficiary_types_updater_idTousers", fields: [updater_id], references: [id])
  conditions_beneficiaries                  conditions_beneficiaries[]
}

model bill_items {
  id                                                              Int                   @id @default(autoincrement())
  code                                                            String?               @db.VarChar(255)
  name_en                                                         String?               @db.VarChar(255)
  name_ar                                                         String?               @db.VarChar(255)
  description                                                     String?
  order                                                           Int?
  bill_id                                                         Int?
  base_scope_id                                                   Int?                  @unique
  created_at                                                      DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                                      DateTime              @db.Timestamptz(6)
  creator_id                                                      Int?
  updater_id                                                      Int?
  type                                                            String?               @default("contractor") @db.VarChar(255)
  bill_contractor_discounted_price                                Decimal?              @db.Decimal(10, 2)
  bill_contractor_extended_price                                  Decimal?              @db.Decimal(10, 2)
  bill_contractor_taxed_price_after                               Decimal?              @db.Decimal(10, 2)
  bill_contractor_taxed_price_before                              Decimal?              @db.Decimal(10, 2)
  bill_individual_discounted_price                                Decimal?              @db.Decimal(10, 2)
  bill_individual_extended_price                                  Decimal?              @db.Decimal(10, 2)
  bill_individual_taxed_price_after                               Decimal?              @db.Decimal(10, 2)
  bill_individual_taxed_price_before                              Decimal?              @db.Decimal(10, 2)
  bill_total_contractor_added_taxes_after                         Decimal?              @db.Decimal(10, 2)
  bill_total_contractor_added_taxes_before                        Decimal?              @db.Decimal(10, 2)
  bill_total_contractor_discounts                                 Decimal?              @db.Decimal(10, 2)
  bill_total_contractor_withhold_taxes_after                      Decimal?              @db.Decimal(10, 2)
  bill_total_contractor_withhold_taxes_before                     Decimal?              @db.Decimal(10, 2)
  bill_total_individual_added_taxes_after                         Decimal?              @db.Decimal(10, 2)
  bill_total_individual_added_taxes_before                        Decimal?              @db.Decimal(10, 2)
  bill_total_individual_discounts                                 Decimal?              @db.Decimal(10, 2)
  bill_total_individual_withhold_taxes_after                      Decimal?              @db.Decimal(10, 2)
  bill_total_individual_withhold_taxes_before                     Decimal?              @db.Decimal(10, 2)
