generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model age_operators {
  id                                    Int          @id @default(autoincrement())
  code                                  String?      @db.VarChar(255)
  name_en                               String?      @db.VarChar(255)
  name_ar                               String?      @db.VarChar(255)
  description                           String?
  min                                   Int?
  max                                   Int?
  created_at                            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime     @db.Timestamptz(6)
  creator_id                            Int?
  updater_id                            Int?
  duration_unit                         String?
  base_scope_id                         Int?         @unique
  base_scopes                           base_scopes? @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_age_operators_creator_idTousers users?       @relation("age_operators_creator_idTousers", fields: [creator_id], references: [id])
  users_age_operators_updater_idTousers users?       @relation("age_operators_updater_idTousers", fields: [updater_id], references: [id])
}

model agenda_slots {
  id                                   Int          @id @default(autoincrement())
  duration                             Int?
  status                               String?      @db.VarChar(255)
  agenda_id                            Int?
  created_at                           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime     @db.Timestamptz(6)
  creator_id                           Int?
  updater_id                           Int?
  base_scope_id                        Int?         @unique
  end_date                             DateTime?    @db.Timestamptz(6)
  start_date                           DateTime?    @db.Timestamptz(6)
  agendas                              agendas?     @relation(fields: [agenda_id], references: [id])
  base_scopes                          base_scopes? @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_agenda_slots_creator_idTousers users?       @relation("agenda_slots_creator_idTousers", fields: [creator_id], references: [id])
  users_agenda_slots_updater_idTousers users?       @relation("agenda_slots_updater_idTousers", fields: [updater_id], references: [id])
}

model agenda_time_ranges {
  id                                         Int                  @id @default(autoincrement())
  created_at                                 DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime             @db.Timestamptz(6)
  creator_id                                 Int?
  updater_id                                 Int?
  base_scope_id                              Int?                 @unique
  agenda_working_day_id                      Int?
  end_time                                   String?              @db.VarChar(255)
  is_break                                   Boolean              @default(false)
  start_time                                 String?              @db.VarChar(255)
  agenda_working_days                        agenda_working_days? @relation(fields: [agenda_working_day_id], references: [id], onDelete: Cascade)
  base_scopes                                base_scopes?         @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_agenda_time_ranges_creator_idTousers users?               @relation("agenda_time_ranges_creator_idTousers", fields: [creator_id], references: [id])
  users_agenda_time_ranges_updater_idTousers users?               @relation("agenda_time_ranges_updater_idTousers", fields: [updater_id], references: [id])
}

model agenda_working_days {
  id                                          Int                  @id @default(autoincrement())
  day_num                                     Int?
  agenda_id                                   Int?
  created_at                                  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime             @db.Timestamptz(6)
  creator_id                                  Int?
  updater_id                                  Int?
  base_scope_id                               Int?                 @unique
  agenda_time_ranges                          agenda_time_ranges[]
  agendas                                     agendas?             @relation(fields: [agenda_id], references: [id], onDelete: Cascade)
  base_scopes                                 base_scopes?         @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_agenda_working_days_creator_idTousers users?               @relation("agenda_working_days_creator_idTousers", fields: [creator_id], references: [id])
  users_agenda_working_days_updater_idTousers users?               @relation("agenda_working_days_updater_idTousers", fields: [updater_id], references: [id])
}

model agendas {
  id                              Int                   @id @default(autoincrement())
  active                          Boolean?              @default(false)
  created_at                      DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime              @db.Timestamptz(6)
  creator_id                      Int?
  updater_id                      Int?
  base_scope_id                   Int?                  @unique
  end_date                        DateTime?             @db.Timestamptz(6)
  interval                        Int?                  @default(0)
  pattern_days                    Int?
  start_date                      DateTime?             @db.Timestamptz(6)
  agenda_slots                    agenda_slots[]
  agenda_working_days             agenda_working_days[]
  base_scopes                     base_scopes?          @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_agendas_creator_idTousers users?                @relation("agendas_creator_idTousers", fields: [creator_id], references: [id])
  users_agendas_updater_idTousers users?                @relation("agendas_updater_idTousers", fields: [updater_id], references: [id])
}

model aggregate_results {
  id                                                                                    Int                 @id @default(autoincrement())
  value                                                                                 Json?
  unit_id                                                                               Int?
  request_procedure_id                                                                  Int?
  base_scope_id                                                                         Int?                @unique
  created_at                                                                            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                                                            DateTime            @db.Timestamptz(6)
  creator_id                                                                            Int?
  updater_id                                                                            Int?
  active                                                                                Boolean             @default(false)
  disp                                                                                  Float?
  panic_range                                                                           String?             @db.VarChar(255)
  reference_range                                                                       String?             @db.VarChar(255)
  status_id                                                                             Int?
  workflow_id                                                                           Int?
  request_procedure_analyte_id                                                          Int?                @unique
  instrument_id                                                                         Int?
  reference_range_description                                                           String?
  base_scopes                                                                           base_scopes?        @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_aggregate_results_creator_idTousers                                             users?              @relation("aggregate_results_creator_idTousers", fields: [creator_id], references: [id])
  instruments                                                                           instruments?        @relation(fields: [instrument_id], references: [id])
  request_procedures_aggregate_results_request_procedure_analyte_idTorequest_procedures request_procedures? @relation("aggregate_results_request_procedure_analyte_idTorequest_procedures", fields: [request_procedure_analyte_id], references: [id], onDelete: Cascade)
  request_procedures_aggregate_results_request_procedure_idTorequest_procedures         request_procedures? @relation("aggregate_results_request_procedure_idTorequest_procedures", fields: [request_procedure_id], references: [id], onDelete: Cascade)
  statuses                                                                              statuses?           @relation(fields: [status_id], references: [id])
  units                                                                                 units?              @relation(fields: [unit_id], references: [id])
  users_aggregate_results_updater_idTousers                                             users?              @relation("aggregate_results_updater_idTousers", fields: [updater_id], references: [id])
  workflows                                                                             workflows?          @relation(fields: [workflow_id], references: [id])
  attachments                                                                           attachments[]
  comment_entries                                                                       comment_entries[]
  status_states                                                                         status_states[]
  companies                                                                             companies[]         @relation("AssignAggregateResultsToCompanies")
}

model antibiotic_families {
  id                                                         Int                         @id @default(autoincrement())
  name_en                                                    String?                     @db.VarChar(255)
  name_ar                                                    String?                     @db.VarChar(255)
  description                                                String?
  properties                                                 String?                     @db.VarChar(255)
  parent_id                                                  Int?
  base_scope_id                                              Int?                        @unique
  created_at                                                 DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                                                 DateTime                    @db.Timestamptz(6)
  creator_id                                                 Int?
  updater_id                                                 Int?
  code                                                       String?                     @db.VarChar(255)
  base_scopes                                                base_scopes?                @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_antibiotic_families_creator_idTousers                users?                      @relation("antibiotic_families_creator_idTousers", fields: [creator_id], references: [id])
  antibiotic_families                                        antibiotic_families?        @relation("antibiotic_familiesToantibiotic_families", fields: [parent_id], references: [id], onDelete: Cascade)
  other_antibiotic_families                                  antibiotic_families[]       @relation("antibiotic_familiesToantibiotic_families")
  users_antibiotic_families_updater_idTousers                users?                      @relation("antibiotic_families_updater_idTousers", fields: [updater_id], references: [id])
  antibiotics_antibiotics_family_idToantibiotic_families     antibiotics[]               @relation("antibiotics_family_idToantibiotic_families")
  antibiotics_antibiotics_sub_family_idToantibiotic_families antibiotics[]               @relation("antibiotics_sub_family_idToantibiotic_families")
  sensitivity_test_families                                  sensitivity_test_families[]
}

model antibiotic_family_groups {
  id                                               Int                       @id @default(autoincrement())
  code                                             String?                   @db.VarChar(255)
  name_en                                          String?                   @db.VarChar(255)
  name_ar                                          String?                   @db.VarChar(255)
  description                                      String?
  base_scope_id                                    Int?                      @unique
  created_at                                       DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime                  @db.Timestamptz(6)
  creator_id                                       Int?
  updater_id                                       Int?
  base_scopes                                      base_scopes?              @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_antibiotic_family_groups_creator_idTousers users?                    @relation("antibiotic_family_groups_creator_idTousers", fields: [creator_id], references: [id])
  users_antibiotic_family_groups_updater_idTousers users?                    @relation("antibiotic_family_groups_updater_idTousers", fields: [updater_id], references: [id])
  sensitivity_test_groups                          sensitivity_test_groups[]
  antibiotics                                      antibiotics[]             @relation("AntibioticFamilyGroupsToAntibiotics")
  organisms                                        organisms[]               @relation("AntibioticFamilyGroupsToOrganisms")
}

model antibiotic_trade_names {
  id                                             Int          @id @default(autoincrement())
  name_en                                        String?      @db.VarChar(255)
  name_ar                                        String?      @db.VarChar(255)
  antibiotic_id                                  Int?
  base_scope_id                                  Int?         @unique
  created_at                                     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                                     DateTime     @db.Timestamptz(6)
  creator_id                                     Int?
  updater_id                                     Int?
  code                                           String?      @db.VarChar(255)
  description                                    String?
  antibiotics                                    antibiotics? @relation(fields: [antibiotic_id], references: [id], onDelete: Cascade)
  base_scopes                                    base_scopes? @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_antibiotic_trade_names_creator_idTousers users?       @relation("antibiotic_trade_names_creator_idTousers", fields: [creator_id], references: [id])
  users_antibiotic_trade_names_updater_idTousers users?       @relation("antibiotic_trade_names_updater_idTousers", fields: [updater_id], references: [id])
}

model antibiotics {
  id                                                                 Int                            @id @default(autoincrement())
  name_ar                                                            String?                        @db.VarChar(255)
  name_en                                                            String?                        @db.VarChar(255)
  short_name_en                                                      String?                        @db.VarChar(255)
  short_name_ar                                                      String?                        @db.VarChar(255)
  scientific_name_en                                                 String?                        @db.VarChar(255)
  scientific_name_ar                                                 String?                        @db.VarChar(255)
  description                                                        String?
  family_id                                                          Int?
  sub_family_id                                                      Int?
  base_scope_id                                                      Int?                           @unique
  created_at                                                         DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                                                         DateTime                       @db.Timestamptz(6)
  creator_id                                                         Int?
  updater_id                                                         Int?
  code                                                               String?                        @db.VarChar(255)
  antibiotic_trade_names                                             antibiotic_trade_names[]
  base_scopes                                                        base_scopes?                   @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_antibiotics_creator_idTousers                                users?                         @relation("antibiotics_creator_idTousers", fields: [creator_id], references: [id])
  antibiotic_families_antibiotics_family_idToantibiotic_families     antibiotic_families?           @relation("antibiotics_family_idToantibiotic_families", fields: [family_id], references: [id], onDelete: Cascade)
  antibiotic_families_antibiotics_sub_family_idToantibiotic_families antibiotic_families?           @relation("antibiotics_sub_family_idToantibiotic_families", fields: [sub_family_id], references: [id], onDelete: Cascade)
  users_antibiotics_updater_idTousers                                users?                         @relation("antibiotics_updater_idTousers", fields: [updater_id], references: [id])
  sensitivity_test_antibiotics                                       sensitivity_test_antibiotics[]
  antibiotic_family_groups                                           antibiotic_family_groups[]     @relation("AntibioticFamilyGroupsToAntibiotics")
}

model attachments {
  id                                  Int                      @id @default(autoincrement())
  name                                String?                  @db.VarChar(255)
  unique_name                         String?                  @db.VarChar(255)
  size                                Int?
  mime_type                           String?                  @db.VarChar(255)
  description                         String?
  created_at                          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                 @db.Timestamptz(6)
  procedure_id                        Int?
  instrument_id                       Int?
  control_sample_id                   Int?
  creator_id                          Int?
  updater_id                          Int?
  base_scope_id                       Int?                     @unique
  patient_id                          Int?                     @unique
  standard_method_id                  Int?
  test_id                             Int?
  measurement_result_id               Int?
  aggregate_result_id                 Int?
  contractor_id                       Int?
  measurement_result_log_id           Int?
  aggregate_results                   aggregate_results?       @relation(fields: [aggregate_result_id], references: [id], onDelete: Cascade)
  base_scopes                         base_scopes?             @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  contractors                         contractors?             @relation(fields: [contractor_id], references: [id], onDelete: Cascade)
  control_samples                     control_samples?         @relation(fields: [control_sample_id], references: [id])
  users_attachments_creator_idTousers users?                   @relation("attachments_creator_idTousers", fields: [creator_id], references: [id])
  instruments                         instruments?             @relation(fields: [instrument_id], references: [id])
  measurement_results                 measurement_results?     @relation(fields: [measurement_result_id], references: [id], onDelete: Cascade)
  measurement_result_logs             measurement_result_logs? @relation(fields: [measurement_result_log_id], references: [id], onDelete: Cascade)
  patients                            patients?                @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  procedures                          procedures?              @relation(fields: [procedure_id], references: [id], onDelete: Cascade)
  standard_methods                    standard_methods?        @relation(fields: [standard_method_id], references: [id], onDelete: Cascade)
  tests                               tests?                   @relation(fields: [test_id], references: [id], onDelete: Cascade)
  users_attachments_updater_idTousers users?                   @relation("attachments_updater_idTousers", fields: [updater_id], references: [id])
}

