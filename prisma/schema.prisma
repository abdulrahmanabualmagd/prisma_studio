model workflows {
  id                                Int                  @id @default(autoincrement())
  name_en                           String?              @db.VarChar(255)
  name_ar                           String?              @db.VarChar(255)
  description                       String?
  created_at                        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime             @db.Timestamptz(6)
  creator_id                        Int?
  updater_id                        Int?
  base_scope_id                     Int?                 @unique
  aggregate_results                 aggregate_results[]
  request_procedures                request_procedures[]
  request_samples                   request_samples[]
  requests                          requests[]
  status_triggers                   status_triggers[]
  statuses                          statuses[]
  base_scopes                       base_scopes?         @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_workflows_creator_idTousers users?               @relation("workflows_creator_idTousers", fields: [creator_id], references: [id])
  users_workflows_updater_idTousers users?               @relation("workflows_updater_idTousers", fields: [updater_id], references: [id])
}

model comment_entries {
  id                                      Int                      @id @default(autoincrement())
  comment                                 String?
  label_en                                String?                  @db.VarChar(255)
  label_ar                                String?                  @db.VarChar(255)
  type                                    String?                  @default("not_applicable") @db.VarChar(255)
  active                                  Boolean                  @default(true)
  measurement_result_id                   Int?
  measurement_result_log_id               Int?
  aggregate_result_id                     Int?
  base_scope_id                           Int?                     @unique
  created_at                              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime                 @db.Timestamptz(6)
  creator_id                              Int?
  updater_id                              Int?
  aggregate_results                       aggregate_results?       @relation(fields: [aggregate_result_id], references: [id], onDelete: Cascade)
  base_scopes                             base_scopes?             @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  users_comment_entries_creator_idTousers users?                   @relation("comment_entries_creator_idTousers", fields: [creator_id], references: [id])
  measurement_results                     measurement_results?     @relation(fields: [measurement_result_id], references: [id], onDelete: Cascade)
  measurement_result_logs                 measurement_result_logs? @relation(fields: [measurement_result_log_id], references: [id], onDelete: Cascade)
  users_comment_entries_updater_idTousers users?                   @relation("comment_entries_updater_idTousers", fields: [updater_id], references: [id])
}

model comments {
  id                               Int          @id @default(autoincrement())
  comment                          String?
  label_en                         String?      @db.VarChar(255)
  label_ar                         String?      @db.VarChar(255)
  type                             String?      @default("not_applicable") @db.VarChar(255)
  active                           Boolean      @default(true)
  procedure_id                     Int?
  category_id                      Int?
  base_scope_id                    Int?         @unique
  created_at                       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime     @db.Timestamptz(6)
  creator_id                       Int?
  updater_id                       Int?
  base_scopes                      base_scopes? @relation(fields: [base_scope_id], references: [id], onDelete: Cascade)
  categories                       categories?  @relation(fields: [category_id], references: [id])
  users_comments_creator_idTousers users?       @relation("comments_creator_idTousers", fields: [creator_id], references: [id])
  procedures                       procedures?  @relation(fields: [procedure_id], references: [id], onDelete: Cascade)
  users_comments_updater_idTousers users?       @relation("comments_updater_idTousers", fields: [updater_id], references: [id])
}
