generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model attachments {
  id             String    @id
  file_name      String
  file_url       String
  file_type      String
  file_size      Int
  uploaded_at    DateTime  @default(now()) @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @db.Timestamptz(6)
  uploaded_by_id String
  message_id     String?
  messages       messages? @relation(fields: [message_id], references: [id])
  users          users     @relation(fields: [uploaded_by_id], references: [id])

  @@index([uploaded_by_id])
}

model audit_logs {
  id         String       @id
  action     audit_action
  model_name String
  record_id  String
  changes    Json?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @db.Timestamptz(6)
  actor_id   String
  users      users        @relation(fields: [actor_id], references: [id])

  @@index([actor_id])
  @@index([model_name, record_id])
}

model cancellations {
  id                      String             @id
  cancelled_by_role       cancellation_actor
  cancelled_at            DateTime           @default(now()) @db.Timestamptz(6)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @db.Timestamptz(6)
  hours_before_start      Int?
  eligible_for_makeup     Boolean            @default(false)
  reason                  String?
  session_id              String             @unique
  cancelled_by_teacher_id String?
  cancelled_by_student_id String?
  cancelled_by_parent_id  String?
  parents                 parents?           @relation(fields: [cancelled_by_parent_id], references: [id])
  students                students?          @relation(fields: [cancelled_by_student_id], references: [id])
  teachers                teachers?          @relation(fields: [cancelled_by_teacher_id], references: [id])
  sessions                sessions           @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model conversation_participants {
  id              String        @id
  joined_at       DateTime      @default(now()) @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @db.Timestamptz(6)
  conversation_id String
  user_id         String
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  users           users         @relation(fields: [user_id], references: [id])

  @@unique([conversation_id, user_id])
}

model conversations {
  id                        String                      @id
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @db.Timestamptz(6)
  conversation_participants conversation_participants[]
  messages                  messages[]
}

model credential_invites {
  id         String    @id
  token      String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @db.Timestamptz(6)
  user_id    String    @unique
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model invoices {
  id              String         @id
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("USD") @db.VarChar(3)
  usd_equivalent  Decimal?       @db.Decimal(10, 2)
  due_date        DateTime       @db.Timestamptz(6)
  grace_until     DateTime?      @db.Timestamptz(6)
  status          invoice_status @default(pending)
  issued_at       DateTime       @default(now()) @db.Timestamptz(6)
  sequence_number Int?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @db.Timestamptz(6)
  paid_at         DateTime?      @db.Timestamptz(6)
  subscription_id String?
  subscriptions   subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: Restrict)
  payments        payments[]
  status_logs     status_logs[]

  @@index([due_date, status])
}

model messages {
  id              String        @id
  content         String
  is_read         Boolean       @default(false)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @db.Timestamptz(6)
  conversation_id String
  sender_id       String
  attachments     attachments[]
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  users           users         @relation(fields: [sender_id], references: [id])

  @@index([conversation_id, created_at])
}

model notifications {
  id           String               @id
  channel      notification_channel
  type         notification_type
  content      String
  is_sent      Boolean              @default(false)
  is_read      Boolean              @default(false)
  scheduled_at DateTime?            @db.Timestamptz(6)
  sent_at      DateTime?            @db.Timestamptz(6)
  created_at   DateTime             @default(now()) @db.Timestamptz(6)
  updated_at   DateTime             @db.Timestamptz(6)
  recipient_id String
  users        users                @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, is_read])
  @@index([scheduled_at, is_sent])
}

model parents {
  id            String          @id
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @db.Timestamptz(6)
  user_id       String          @unique
  status        profile_status  @default(incomplete)
  cancellations cancellations[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status_logs   status_logs[]
  students      students[]
  subscriptions subscriptions[]
}

model payments {
  id                String           @id
  currency          String           @default("USD") @db.VarChar(3)
  status            payment_status   @default(pending)
  paid_at           DateTime?        @db.Timestamptz(6)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @db.Timestamptz(6)
  invoice_id        String
  credit            Decimal          @default(0) @db.Decimal(10, 2)
  debit             Decimal          @default(0) @db.Decimal(10, 2)
  payment_method_id String?
  source            payment_source   @default(pay)
  invoices          invoices         @relation(fields: [invoice_id], references: [id])
  payment_methods   payment_methods? @relation(fields: [payment_method_id], references: [id], onDelete: Restrict)
  status_logs       status_logs[]
}

model permissions {
  operation_name         String                   @id
  action                 permission_action
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @db.Timestamptz(6)
  resource_id            String
  resources              resources                @relation(fields: [resource_id], references: [model_name], onDelete: Cascade)
  roles_permissions_junc roles_permissions_junc[]
  users_permissions_junc users_permissions_junc[]
}

model pricings {
  id                 String             @id
  language           String?            @db.VarChar(2)
  currency           String             @default("EGP") @db.VarChar(3)
  session_type       session_type
  age_classification age_classification
  student_level      student_level
  rate_per_hour      Decimal            @db.Decimal(10, 2)
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @db.Timestamptz(6)
  course_id          String
  country            String?            @db.VarChar(2)
  courses            courses            @relation(fields: [course_id], references: [id], onDelete: Cascade)
  subscriptions      subscriptions[]
  wages              wages[]

  @@unique([country, course_id, session_type, language, age_classification, student_level])
}

model resources {
  model_name  String        @id
  name_en     String?
  name_ar     String?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @db.Timestamptz(6)
  permissions permissions[]
}

model roles {
  id                     String                   @id
  name_ar                String                   @unique
  name_en                String                   @unique
  description            String
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @db.Timestamptz(6)
  roles_permissions_junc roles_permissions_junc[]
  users                  users[]                  @relation("user_to_role_relation")
}

model roles_permissions_junc {
  role_id        String
  operation_name String
  condition      permission_condition
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @db.Timestamptz(6)
  permissions    permissions          @relation(fields: [operation_name], references: [operation_name], onDelete: Cascade)
  roles          roles                @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, operation_name])
}

model session_reports {
  id              String          @id
  recitation_type recitation_type
  from_surah      String?
  from_ayah       Int?
  to_surah        String?
  to_ayah         Int?
  rating          Int             @db.SmallInt
  parent_notes    String?
  teacher_notes   String?
  submitted_at    DateTime        @default(now()) @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @db.Timestamptz(6)
  session_id      String          @unique
  teacher_id      String
  sessions        sessions        @relation(fields: [session_id], references: [id], onDelete: Cascade)
  teachers        teachers        @relation(fields: [teacher_id], references: [id])
}

model sessions {
  id                                                String                @id
  scheduled_at_utc                                  DateTime              @db.Timestamptz(6)
  duration_minutes                                  Int                   @default(30)
  status                                            session_status        @default(scheduled)
  meeting_url                                       String?
  platform                                          meeting_platform      @default(zoom)
  meeting_id                                        String?
  actual_start                                      DateTime?             @db.Timestamptz(6)
  actual_end                                        DateTime?             @db.Timestamptz(6)
  is_makeup                                         Boolean               @default(false)
  created_at                                        DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime              @db.Timestamptz(6)
  student_id                                        String
  teacher_id                                        String
  substitute_teacher_id                             String?
  schedule_id                                       String?
  original_session_id                               String?
  subscription_id                                   String?
  cancellations                                     cancellations?
  session_reports                                   session_reports?
  sessions                                          sessions?             @relation("sessionsTosessions", fields: [original_session_id], references: [id])
  other_sessions                                    sessions[]            @relation("sessionsTosessions")
  schedules                                         schedules?            @relation(fields: [schedule_id], references: [id])
  students                                          students              @relation(fields: [student_id], references: [id])
  subscriptions                                     subscriptions?        @relation(fields: [subscription_id], references: [id])
  teachers_sessions_substitute_teacher_idToteachers teachers?             @relation("sessions_substitute_teacher_idToteachers", fields: [substitute_teacher_id], references: [id])
  teachers_sessions_teacher_idToteachers            teachers              @relation("sessions_teacher_idToteachers", fields: [teacher_id], references: [id])
  status_logs                                       status_logs[]
  student_assessments                               student_assessments[]

  @@index([scheduled_at_utc])
  @@index([student_id, scheduled_at_utc])
  @@index([teacher_id, scheduled_at_utc])
}

model student_assessments {
  id                String          @id
  overall_level     overall_level
  reading_skill     reading_skill
  letters_skill     letters_skill
  tajweed_skill     tajweed_skill
  attention_level   attention_level
  memorized_content String?
  medical_notes     String?
  assessment_date   DateTime        @default(now()) @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @db.Timestamptz(6)
  teacher_id        String
  student_id        String
  course_id         String
  session_id        String?
  courses           courses         @relation(fields: [course_id], references: [id])
  sessions          sessions?       @relation(fields: [session_id], references: [id])
  students          students        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teachers          teachers        @relation(fields: [teacher_id], references: [id])
}

model students {
  id                  String                @id
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @db.Timestamptz(6)
  user_id             String                @unique
  parent_id           String?
  status              profile_status        @default(incomplete)
  availabilities      availabilities[]
  cancellations       cancellations[]
  schedules           schedules[]
  sessions            sessions[]
  status_logs         status_logs[]
  student_assessments student_assessments[]
  parents             parents?              @relation(fields: [parent_id], references: [id])
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscriptions       subscriptions[]
}

model subscriptions {
  id                       String              @id
  total_minutes            Int?
  used_minutes             Int                 @default(0)
  default_session_duration Int                 @default(30)
  hourly_price             Decimal             @db.Decimal(10, 2)
  currency                 String              @default("USD") @db.VarChar(3)
  billing_type             billing_type        @default(prepaid)
  installment_count        Int?
  billing_start            DateTime            @db.Timestamptz(6)
  billing_end              DateTime?           @db.Timestamptz(6)
  status                   subscription_status @default(active)
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  updated_at               DateTime            @db.Timestamptz(6)
  deleted_at               DateTime?           @db.Timestamptz(6)
  student_id               String
  course_id                String
  pricing_id               String?
  parent_id                String?
  grace_minutes            Int                 @default(0)
  grace_period_days        Int                 @default(0)
  rollover_minutes         Int                 @default(0)
  expiration_behavior      expiration_behavior @default(hard_stop)
  rollover_policy          rollover_policy     @default(none)
  invoices                 invoices[]
  schedules                schedules[]
  sessions                 sessions[]
  status_logs              status_logs[]
  courses                  courses             @relation(fields: [course_id], references: [id])
  parents                  parents?            @relation(fields: [parent_id], references: [id], onDelete: Restrict)
  pricings                 pricings?           @relation(fields: [pricing_id], references: [id], onDelete: Restrict)
  students                 students            @relation(fields: [student_id], references: [id])

  @@index([parent_id, student_id, course_id, status])
}

model teachers {
  id                                                String                @id
  bio                                               String?
  created_at                                        DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime              @db.Timestamptz(6)
  user_id                                           String                @unique
  status                                            profile_status        @default(incomplete)
  availabilities                                    availabilities[]
  cancellations                                     cancellations[]
  schedules                                         schedules[]
  session_reports                                   session_reports[]
  sessions_sessions_substitute_teacher_idToteachers sessions[]            @relation("sessions_substitute_teacher_idToteachers")
  sessions_sessions_teacher_idToteachers            sessions[]            @relation("sessions_teacher_idToteachers")
  status_logs                                       status_logs[]
  student_assessments                               student_assessments[]
  teacher_courses                                   teacher_courses[]
  users                                             users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id                        String                      @id
  first_name                String?
  middle_name               String?
  last_name                 String?
  gender                    gender?
  country                   String?                     @db.VarChar(2)
  city                      String?
  phone_number              String?                     @db.VarChar(15)
  timezone                  String                      @default("UTC")
  primary_language          String?                     @db.VarChar(2)
  secondary_languages       String[]                    @default([])
  grant_login               Boolean                     @default(false)
  email                     String?                     @unique
  username                  String?                     @unique
  password_hash             String?
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @db.Timestamptz(6)
  deleted_at                DateTime?                   @db.Timestamptz(6)
  dialing_code              String?                     @db.VarChar(4)
  status                    user_status                 @default(pending_verification)
  active_profiles           profile_type[]              @default([])
  attachments               attachments[]
  audit_logs                audit_logs[]
  conversation_participants conversation_participants[]
  credential_invites        credential_invites?
  messages                  messages[]
  notifications             notifications[]
  parents                   parents?
  status_logs               status_logs[]
  students                  students?
  teachers                  teachers?
  users_permissions_junc    users_permissions_junc[]
  roles                     roles[]                     @relation("user_to_role_relation")

  @@unique([dialing_code, phone_number])
}

model users_permissions_junc {
  user_id        String
  operation_name String
  effect         AccessEffect         @default(allow)
  condition      permission_condition
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @db.Timestamptz(6)
  permissions    permissions          @relation(fields: [operation_name], references: [operation_name], onDelete: Cascade)
  users          users                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, operation_name])
}

model availabilities {
  id             String      @id
  day_of_week    day_of_week
  start_time_utc DateTime    @db.Timetz(6)
  end_time_utc   DateTime    @db.Timetz(6)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @db.Timestamptz(6)
  student_id     String?
  teacher_id     String?
  students       students?   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teachers       teachers?   @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
}

model course_topics {
  course_id  String
  topic_id   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  courses    courses  @relation(fields: [course_id], references: [id], onDelete: Cascade)
  topics     topics   @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@id([course_id, topic_id])
}

model courses {
  id                  String                @id
  name_en             String
  name_ar             String
  description_en      String?
  description_ar      String?
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  course_topics       course_topics[]
  pricings            pricings[]
  student_assessments student_assessments[]
  subscriptions       subscriptions[]
  teacher_courses     teacher_courses[]
}

model schedule_slots {
  id               String      @id
  day_of_week      day_of_week
  time_utc         DateTime    @db.Timetz(6)
  duration_minutes Int
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @db.Timestamptz(6)
  schedule_id      String
  schedules        schedules   @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
}

model schedules {
  id                String           @id
  start_date        DateTime         @db.Timestamptz(6)
  end_date          DateTime?        @db.Timestamptz(6)
  last_generated_at DateTime?        @db.Timestamptz(6)
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @db.Timestamptz(6)
  student_id        String
  teacher_id        String
  payout_rate       Decimal?         @db.Decimal(10, 2)
  subscription_id   String?
  wage_id           String?
  schedule_slots    schedule_slots[]
  students          students         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subscriptions     subscriptions?   @relation(fields: [subscription_id], references: [id])
  teachers          teachers         @relation(fields: [teacher_id], references: [id])
  wages             wages?           @relation(fields: [wage_id], references: [id])
  sessions          sessions[]
}

model status_logs {
  id              String         @id
  reason          String?
  metadata        Json?
  user_id         String?
  student_id      String?
  teacher_id      String?
  parent_id       String?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @db.Timestamptz(6)
  invoice_id      String?
  payment_id      String?
  session_id      String?
  subscription_id String?
  status          String
  invoices        invoices?      @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  parents         parents?       @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  payments        payments?      @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  sessions        sessions?      @relation(fields: [session_id], references: [id], onDelete: Cascade)
  students        students?      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subscriptions   subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  teachers        teachers?      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  users           users?         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([invoice_id, created_at(sort: Desc)])
  @@index([parent_id, created_at(sort: Desc)])
  @@index([payment_id, created_at(sort: Desc)])
  @@index([session_id, created_at(sort: Desc)])
  @@index([student_id, created_at(sort: Desc)])
  @@index([subscription_id, created_at(sort: Desc)])
  @@index([teacher_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
}

model teacher_courses {
  teacher_id  String
  course_id   String
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @db.Timestamptz(6)
  courses     courses  @relation(fields: [course_id], references: [id], onDelete: Cascade)
  teachers    teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@id([teacher_id, course_id])
}

model topics {
  id             String          @id
  name_en        String
  name_ar        String
  description_en String?
  description_ar String?
  is_active      Boolean         @default(true)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @db.Timestamptz(6)
  deleted_at     DateTime?       @db.Timestamptz(6)
  parent_id      String?
  course_topics  course_topics[]
  topics         topics?         @relation("topicsTotopics", fields: [parent_id], references: [id])
  other_topics   topics[]        @relation("topicsTotopics")
}

model wages {
  id            String        @id
  teacher_level teacher_level
  payout_rate   Decimal       @db.Decimal(10, 2)
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @db.Timestamptz(6)
  pricing_id    String
  currency      String        @default("EGP") @db.VarChar(3)
  schedules     schedules[]
  pricings      pricings      @relation(fields: [pricing_id], references: [id], onDelete: Cascade)

  @@unique([teacher_level, pricing_id])
}

model payment_methods {
  id                  String     @id
  type                String
  provider            String?
  last_four           String?    @db.VarChar(4)
  expiry_month        Int?
  expiry_year         Int?
  gateway_customer_id String?
  gateway_token       String?
  is_default          Boolean    @default(false)
  metadata            Json?
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime   @db.Timestamptz(6)
